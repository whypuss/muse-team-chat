# Muse Team Chat 環境變數範本
# 複製此檔案為 .env 並填入實際數值（切勿將含真實金鑰的 .env 提交至 Git）

# 伺服器連接埠（預設 8080）
PORT=8080

# SQLite 資料庫路徑（預設 data/chat.db）
DB_PATH=data/chat.db

# 輪詢浮水印儲存路徑（記錄最後已派送訊息 ID）
WATERMARK_PATH=data/watermark.json

# 自動輪詢間隔（秒，預設 5）
POLL_INTERVAL=5

# LLM 整合設定（留空則自動以內建角色規則 demo 模式運行）
# 支援任何相容 OpenAI API 格式的端點（如 OpenAI、Ollama、OpenRouter、vLLM 等）
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=
